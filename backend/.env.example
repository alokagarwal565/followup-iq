# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Runtime ---------------------------------------------------------------
# development | test | production
ENV=development
LOG_LEVEL=INFO
# IANA timezone that defines "today" for follow-ups.
BUSINESS_TZ=Asia/Kolkata

# --- Database (required) ---------------------------------------------------
# Supabase "Session pooler" URI (IPv4, port 5432, user postgres.<project-ref>).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Separate database used only by pytest; each run creates and drops its own schema.
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins.
CORS_ORIGINS=http://localhost:3000
# Optional regex, e.g. for Vercel preview deployments.
CORS_ORIGIN_REGEX=

# --- Gemini ----------------------------------------------------------------
# Key slots are tried in order. Quotas apply per Google Cloud project, so extra
# keys only add headroom when they belong to different projects.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Optional extra keys, comma-separated, tried after the slots above.
GEMINI_API_KEY_FALLBACKS=

# Model chain: HEAVY -> FALLBACK_HEAVY -> FAST -> FALLBACK_FAST.
GEMINI_MODEL_HEAVY=gemini-3.6-flash
GEMINI_MODEL_FALLBACK_HEAVY=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK_FAST=gemini-3.1-flash-lite
# Optional comma-separated list that replaces the four tiers above.
GEMINI_MODEL_CHAIN=

GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_ANALYSIS_DEADLINE_SECONDS=60
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BACKOFF_BASE_SECONDS=0.5
GEMINI_MAX_ATTEMPTS=8
# 1 = deterministic fake provider for tests/E2E. Refused when ENV=production.
GEMINI_FAKE=0

# --- Abuse protection (public demo has no login) ---------------------------
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_ANALYZE_PER_MIN=10

# --- File storage (not used by the current scope; reserved) ----------------
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./.storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT_URL=
